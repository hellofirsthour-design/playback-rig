{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playback Rig",
  "version": "0.1.0",
  "identifier": "com.hellofirsthour.playbackrig",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Playback Rig",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#0f1318"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
